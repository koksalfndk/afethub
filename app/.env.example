# Copy to .env and fill in your AfetHUB Supabase project values.
# Leave BOTH blank to run the app against the in-memory local data layer.
# The anon / publishable key is safe to expose in the client — Row-Level
# Security (see supabase/schema.sql) is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — public contact form bot check.
# The SITE key is public and belongs here; the SECRET key is a Supabase Edge Function
# secret (TURNSTILE_SECRET) and must never appear in this file or in the client bundle.
# Leave blank to ship without the check: the widget then does not render and
# `contact-submit` replies with turnstile:"off" so the absence is visible, not assumed.
VITE_TURNSTILE_SITE_KEY=
